# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า  (ห้าม commit .env ขึ้น GitHub)

# test = Test Zone, prod = Production Zone
NHSO_ENV=test

# ---------- ตรวจสอบสิทธิ (SRM) ----------
# ค่าเริ่มต้น: %USERPROFILE%\SRM Smart Card Single Sign-On\token.txt
# (ไฟล์นี้อัปเดตทุกครั้งที่เสียบบัตร Login SRM Portal — โปรแกรมอ่านเองอัตโนมัติ)
# SRM_TOKEN_FILE=%USERPROFILE%\SRM Smart Card Single Sign-On\token.txt
# หรือใส่ token เองตรงนี้ / ใช้คำสั่ง `python -m nhso_right_check token set`
# SRM_ACCESS_TOKEN=

# ---------- ปิดสิทธิ (NHSO ENDPOINT FOR SINGLE CLAIM) ----------
# TOKEN KEY ที่ สปสช. ส่งทางอีเมล (ใช้ได้เฉพาะ HCODE ที่ขอ)
NHSO_ENDPOINT_TOKEN=
HCODE=
# ชื่อหน่วยงานที่เชื่อมต่อ API (ถ้าว่างจะใช้ HCODE)
SOURCE_ID=
# เลขบัตรประชาชนเจ้าหน้าที่ผู้บันทึก
RECORDER_PID=

# path ตาม Swagger UI — ตรวจที่ https://test.nhso.go.th/nhsoendpoint/swagger-ui.html ก่อนใช้งาน
# NHSO_CLAIM_PATH=api/nhso-claim-detail
# NHSO_CANCEL_PATH=api/nhso-claim-detail
# NHSO_CANCEL_METHOD=PUT

# ---------- ทั่วไป ----------
# HTTP_TIMEOUT=30
# BATCH_DELAY=0.5
# DB_PATH=nhso_right_check_log.sqlite3
